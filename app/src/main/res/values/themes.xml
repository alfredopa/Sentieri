<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_700</item> <!-- Cambiato da teal_200 per più contrasto in chiaro -->
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Collegamento dei temi per i dialoghi -->
        <item name="android:alertDialogTheme">@style/AlertDialogCustom</item>
        <item name="alertDialogTheme">@style/AlertDialogCustom</item>

        <!-- Colore hamburger menu e contestuale. -->
        <item name="colorControlNormal">@color/white</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- AlertDialog personalizzato per temi Chiaro e Scuro -->
    <style name="AlertDialogCustom" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/AlertDialogTitleStyle</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <!-- Forza il colore dei testi della lista -->
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <!-- Stile pulsanti -->
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonStyle.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButtonStyle</item>
    </style>

    <style name="AlertDialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item> <!-- Testo in grassetto per visibilità -->
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Opzionale: per il pulsante di conferma/eliminazione usiamo un colore di contrasto (es. Rosso/Error) -->
    <style name="AlertDialogButtonStyle.Positive" parent="AlertDialogButtonStyle">
        <item name="android:textColor">?attr/colorError</item> <!-- Rosso per l'azione di eliminazione -->
    </style>

    <!-- Stile per il titolo del dialogo (opzionale, per coerenza) -->
    <style name="AlertDialogTitleStyle" parent="@android:style/TextAppearance.Holo.DialogWindowTitle">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

</resources>
