<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!--<item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item> -->
        <!-- Customize your theme here. -->
    </style>

    <!-- AlertDialog personalizzato per temi Chiaro e Scuro -->
    <style name="AlertDialogCustom" parent="Theme.Material3.DayNight.Dialog.Alert">
        <!-- Colore del testo del titolo -->
        <item name="android:windowTitleStyle">@style/AlertDialogTitleStyle</item>
        <!-- Colore del testo del messaggio -->
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <!-- Colore di sfondo del dialogo -->
        <item name="android:background">?attr/colorSurface</item>

        <!-- Stile per i pulsanti -->
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButtonStyle</item>
    </style>

    <!-- Stile per i pulsanti del dialogo -->
    <style name="AlertDialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Usa il colore primario del tema, che si adatta a chiaro/scuro -->
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Stile per il titolo del dialogo (opzionale, per coerenza) -->
    <style name="AlertDialogTitleStyle" parent="@android:style/TextAppearance.Holo.DialogWindowTitle">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

</resources>
