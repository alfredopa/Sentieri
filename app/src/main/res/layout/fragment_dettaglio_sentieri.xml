<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="MyViewModel"
            type="com.apstudio.sentieri.SentieriViewModel"/>
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="6dp"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        app:contentPadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.979">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/riga_dettaglio"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/Dislivello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Ascesa"
                app:layout_constraintStart_toEndOf="@+id/lunghezza_Text"
                app:layout_constraintTop_toTopOf="@+id/lunghezza_Text" />

            <TextView
                android:id="@+id/nome_Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:scrollIndicators="right"
                android:text="nome_Text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/Livello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Discesa"
                app:layout_constraintStart_toEndOf="@+id/dislivello_Text"
                app:layout_constraintTop_toTopOf="@+id/dislivello_Text" />

            <TextView
                android:id="@+id/dislivello_Text"
                android:layout_width="39dp"
                android:layout_height="19dp"
                android:layout_marginStart="6dp"
                android:text="txDisliv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.049"
                app:layout_constraintStart_toEndOf="@+id/Dislivello"
                app:layout_constraintTop_toTopOf="@+id/Dislivello" />

            <TextView
                android:id="@+id/Distanza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="Distanza"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nome_Text" />

            <TextView
                android:id="@+id/lunghezza_Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="lungh"
                app:layout_constraintStart_toEndOf="@+id/Distanza"
                app:layout_constraintTop_toTopOf="@+id/Distanza" />

            <TextView
                android:id="@+id/discesa_Text"
                android:layout_width="39dp"
                android:layout_height="19dp"
                android:layout_marginStart="6dp"
                android:text="discesa_Text"
                app:layout_constraintStart_toEndOf="@+id/Livello"
                app:layout_constraintTop_toTopOf="@+id/Livello" />

            <TextView
                android:id="@+id/tvVelo"
                android:layout_width="42dp"
                android:layout_height="19dp"
                android:layout_marginStart="4dp"
                android:text="Med"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                app:layout_constraintTop_toTopOf="@+id/imageView" />

            <TextView
                android:id="@+id/hrmedia_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="HrMedia"
                app:layout_constraintStart_toEndOf="@+id/tvVelo"
                app:layout_constraintTop_toTopOf="@+id/tvVelo" />

            <TextView
                android:id="@+id/tvDistH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Max"
                app:layout_constraintStart_toEndOf="@+id/hrmedia_text"
                app:layout_constraintTop_toTopOf="@+id/hrmedia_text" />

            <TextView
                android:id="@+id/hrmax_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="hrmax"
                app:layout_constraintStart_toEndOf="@+id/tvDistH"
                app:layout_constraintTop_toTopOf="@+id/tvDistH" />

            <TextView
                android:id="@+id/tvTempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="Inizio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/Distanza" />

            <TextView
                android:id="@+id/Data_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="DataOra"
                app:layout_constraintStart_toEndOf="@+id/tvTempo"
                app:layout_constraintTop_toTopOf="@+id/tvTempo" />

            <TextView
                android:id="@+id/tvQuota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tempo tot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvTempo"
                app:layout_constraintTop_toBottomOf="@+id/tvTempo"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tDataInizio_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="TempoTot"
                app:layout_constraintStart_toEndOf="@+id/tvQuota"
                app:layout_constraintTop_toTopOf="@+id/tvQuota" />

            <TextView
                android:id="@+id/tTempoMovText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Tempo mov"
                app:layout_constraintStart_toEndOf="@+id/tDataInizio_text"
                app:layout_constraintTop_toTopOf="@+id/tvQuota" />

            <TextView
                android:id="@+id/tDataFine_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="TempoMov"
                app:layout_constraintStart_toEndOf="@+id/tTempoMovText"
                app:layout_constraintTop_toTopOf="@+id/tvQuota" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:layout_marginStart="128dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView16"
                app:srcCompat="@drawable/hearth" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Fine"
                app:layout_constraintStart_toEndOf="@+id/Data_text"
                app:layout_constraintTop_toTopOf="@+id/tvTempo" />

            <TextView
                android:id="@+id/fine_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Fine"
                app:layout_constraintStart_toEndOf="@+id/textView8"
                app:layout_constraintTop_toTopOf="@+id/tvTempo" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vel. media"
                app:layout_constraintStart_toStartOf="@+id/tvQuota"
                app:layout_constraintTop_toBottomOf="@+id/tvQuota" />

            <TextView
                android:id="@+id/velMedia_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Media"
                app:layout_constraintStart_toEndOf="@+id/textView16"
                app:layout_constraintTop_toTopOf="@+id/textView16" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>
