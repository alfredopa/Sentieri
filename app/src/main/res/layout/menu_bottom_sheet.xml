<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Esempio di voce menu -->
    <TextView
        android:id="@+id/menu_lista"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="Lista Sentieri"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/round_navigation_white_48"
        android:drawablePadding="16dp" />

    <TextView
        android:id="@+id/menu_gps"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="GPS / Registrazione"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/gps_off"
        android:drawablePadding="16dp" />

    <TextView
        android:id="@+id/menu_poi"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Waypoint"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/pin_rosso"
        android:drawablePadding="16dp" />

    <!-- Aggiungi qui gli altri item... -->
</LinearLayout>