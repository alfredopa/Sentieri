<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/sos_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGENZA"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/sos_coords_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUE COORDINATE:"
        android:textSize="14sp"
        android:alpha="0.7" />

    <TextView
        android:id="@+id/sos_coordinates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAT: 00.00000\nLON: 00.00000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/sos_accuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accuratezza: +/- 10m"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_copy_coords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COPIA COORDINATE"
        android:backgroundTint="@android:color/darker_gray"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_call_emergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHIAMA 112"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>