<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradiente dal blu scuro al blu più profondo -->
    <gradient
        android:startColor="#0F2070"
        android:endColor="#060C30"
        android:angle="270" />

    <!-- Angoli arrotondati solo sul lato destro -->
    <corners
        android:topRightRadius="24dp"
        android:bottomRightRadius="24dp" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>