<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/barometro">

        <SwitchPreferenceCompat
            app:key="haBaro"
            app:selectable="false"
            app:title="@string/barometro" />

        <SwitchPreferenceCompat
            app:dependency="haBaro"
            app:key="setBaro"
            app:summaryOff="Non utilizza per calcolo altitudine"
            app:summaryOn="utilizza per calcolo altitudine"
            app:title="Se presente barometro" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Mappe">
        <SwitchPreferenceCompat
            app:key="isMapOnline"
            app:title="Mappa online" />
    </PreferenceCategory>

</PreferenceScreen>